# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 活跃交互约 25 ms 刷新；主循环另有自适应延时，空闲仍会拉长。
CONFIG_LV_DEF_REFR_PERIOD=25
# Ashbox UI uses ashbox_font_16 only; demos that need Montserrat are not linked.
# Tiny UNSCII keeps LVGL's required default font without Montserrat Flash fat (C-FAT1 / O-FAT).
# LVGL examples/demos reference Montserrat — must stay off so FONT_MONTSERRAT_*=n can link.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_FONT_MONTSERRAT_14=n
CONFIG_LV_FONT_MONTSERRAT_20=n
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_FONT_DEFAULT_UNSCII_8=y
# 余烬主屏对象更多：抬高 LVGL 池；半帧定格时优先查池而非驱动。
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# 余烬离线放置：不启蓝牙。Wi-Fi 仍随 IDF 默认链接但应用从不 init（射频冷）。
CONFIG_BT_ENABLED=n
